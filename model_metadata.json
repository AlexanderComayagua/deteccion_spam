{
    "project_name": "Spam Email & SMS Classifier",
    "model_file": "modelo_spam_arbol.pkl",
    "model_type": "DecisionTreeClassifier",
    "vectorizer": "CountVectorizer",
    "hyperparameters": {
        "max_features": 3000,
        "stop_words": "english",
        "criterion": "gini",
        "max_depth": 16,
        "min_samples_leaf": 5,
        "random_state": 240
    },
    "classes": {
        "0": "Ham (Legítimo)",
        "1": "Spam"
    },
    "metrics": {
        "accuracy": 0.9614,
        "precision": 0.9141,
        "recall": 0.7852,
        "f1_score": 0.8448
    },
    "sklearn_version": "1.6.1"
}